[Unit]
Description=Rover decision service
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=rover
WorkingDirectory=/opt/rover
Environment=ROVER_CONFIG_DIR=/opt/rover/config
ExecStart=/opt/rover/.venv/bin/python -m rover.services.decision.main
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
